import time
from datetime import datetime
import numpy as np
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC

# Function to perform KPI actions
def Kpi_Action(kpi_id):
    try:
        print(f"Processing KPI Action for KPI ID: {kpi_id}")
        # Convert KPI ID to required format (integer string without decimal)
        kpi_id_text = str(int(float(kpi_id))).strip()
        
        # Locate table rows
        rows = WebDriverWait(driver, 20).until(
            EC.presence_of_all_elements_located((By.XPATH, "//table[@role='table' and contains(@class, 'p-datatable-table')]/tbody/tr"))
        )

        # Loop through rows to find the KPI ID in the third column
        for row in rows:
            third_column_value = row.find_element(By.XPATH, "./td[3]").text
            if third_column_value == kpi_id_text:
                print(f"KPI ID {kpi_id_text} found, performing action")
                
                # Click the action button in the ninth column
                action_button = row.find_element(By.XPATH, "./td[9]/button/span[1]")
                action_button.click()
                
                # Process fields from the Excel sheet
                process_fields_from_excel(row, kpi_id_text)

                break
        else:
            print(f"KPI ID {kpi_id_text} not found in the table.")

    except Exception as e:
        print(f"Error in Kpi_Action: {e}")


def process_fields_from_excel(row, kpi_id_text):
    # Retrieve values from the current Excel row
    excel_row = df[df['KPI ID'] == int(kpi_id_text)]
    if excel_row.empty:
        print(f"No data found for KPI ID {kpi_id_text} in Excel.")
        return

    # Process each Action and corresponding details
    action_index = 1
